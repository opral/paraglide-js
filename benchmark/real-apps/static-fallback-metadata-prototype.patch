+function resolveStaticText(
+	bundleId: string,
+	messagesByLocale: Map<string, BundleNested["messages"][number]>,
+	locale: string,
+	fallbackMap: Record<string, string | undefined>
+): string | undefined {
+	const visited = new Set<string>();
+	let currentLocale: string | undefined = locale;
+
+	while (currentLocale && !visited.has(currentLocale)) {
+		visited.add(currentLocale);
+		const message = messagesByLocale.get(currentLocale);
+		if (message) {
+			const variant =
+				message.variants.length === 1 ? message.variants[0] : undefined;
+			if (!variant || !variant.pattern.every((part) => part.type === "text")) {
+				return undefined;
+			}
+			return variant.pattern
+				.map((part) => (part.type === "text" ? part.value : ""))
+				.join("")
+				.replace(/\r\n?/g, "\n");
+		}
+		currentLocale = fallbackMap[currentLocale];
+	}
+
+	// locale-modules emits the bundle ID when no locale in the fallback chain
+	// contains this message.
+	return bundleId;
+}
