diff --git a/src/bundler-plugins/per-locale-build/normalize-compiler-marker.ts b/src/bundler-plugins/per-locale-build/normalize-compiler-marker.ts
new file mode 100644
index 0000000..dbecc32
--- /dev/null
+++ b/src/bundler-plugins/per-locale-build/normalize-compiler-marker.ts
@@ -0,0 +1,50 @@
+import nodePath from "node:path";
+import { parse } from "acorn";
+import MagicString from "magic-string";
+import type { Plugin } from "vite";
+import { PER_LOCALE_BUILD_MARKER } from "./constants.js";
+import { perLocaleBuildStaticLocaleExpression } from "../../compiler/per-locale-build.js";
+
+/** Private host compatibility experiment: Vite 8.0/Oxc skips a parenthesized object define. */
+export function createCompilerMarkerNormalizationPlugin(args: {
+ outdir: () => string | undefined;
+}): Plugin {
+ return {
+  name: "paraglide-private-compiler-marker-normalization",
+  enforce: "pre",
+  transform: {
+   order: "pre",
+   handler(code, id) {
+    const outdir = args.outdir();
+    if (!outdir) return null;
+    const file = id.split(/[?#]/)[0]!;
+    const relative = nodePath.relative(nodePath.resolve(outdir), file);
+    if (relative === ".." || relative.startsWith(".." + nodePath.sep) || nodePath.isAbsolute(relative) || !file.endsWith(".js")) return null;
+    return normalizeCompilerMarker(code);
+   },
+  },
+ };
+}
+
+export function normalizeCompilerMarker(code: string): { code: string; map: ReturnType<MagicString["generateMap"]> } | null {
+ if (!code.includes(perLocaleBuildStaticLocaleExpression)) return null;
+ const tree = parse(code, { ecmaVersion: "latest", sourceType: "module" });
+ const output = new MagicString(code);
+ let changed = false;
+ const visit = (value: unknown): void => {
+  if (!value || typeof value !== "object") return;
+  const node = value as Record<string, unknown>;
+  const object = node.object as Record<string, unknown> | undefined;
+  const property = node.property as Record<string, unknown> | undefined;
+  if (node.type === "MemberExpression" && node.computed === false && object?.type === "Identifier" && object.name === "globalThis" && property?.type === "Identifier" && property.name === PER_LOCALE_BUILD_MARKER && typeof node.start === "number" && typeof node.end === "number" && code.slice(node.start, node.end) === `(globalThis).${PER_LOCALE_BUILD_MARKER}`) {
+   output.overwrite(node.start, node.end, `globalThis.${PER_LOCALE_BUILD_MARKER}`);
+   changed = true;
+  }
+  for (const child of Object.values(node)) {
+   if (Array.isArray(child)) child.forEach(visit);
+   else if (child && typeof child === "object") visit(child);
+  }
+ };
+ visit(tree);
+ return changed ? { code: output.toString(), map: output.generateMap({ hires: true }) } : null;
+}
