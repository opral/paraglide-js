+// Login and invite screens are direct, lazy routes outside the authenticated
+// app shell. Start their one extra namespace alongside the app's usual
+// startup namespaces so the Login component's normal useTranslation('auth')
+// hook sees the same i18next resources without waiting for its route chunk.
+// The router basename comes from the production <base href>, so root and
+// reverse-proxy subpath deployments use the same route check.
+function initialNamespacesForRoute() {
+  const basename = routerBasename === '/' ? '' : routerBasename.replace(/\/+$/, '')
+  const pathname = window.location.pathname
+  const routePath = basename && (pathname === basename || pathname.startsWith(`${basename}/`))
+    ? (pathname.slice(basename.length) || '/')
+    : pathname
+  const isLoginRoute = /^\/login\/?$/.test(routePath)
+  const isInviteRoute = /^\/invite\/[^/]+\/?$/.test(routePath)
+  return isLoginRoute || isInviteRoute
+    ? ['common', 'nav', 'errors', 'auth']
+    : ['common', 'nav', 'errors']
+}
+
+const routeNamespaces = initialNamespacesForRoute()
+const authRoute = routeNamespaces.includes('auth')
+
 i18n
   .use(HttpBackend)
   .use(LanguageDetector)
   .use(initReactI18next)
   .init({
     fallbackLng: 'en',
+    partialBundledLanguages: true,
+    resources: { en: { auth: englishAuth } },
     supportedLngs: SUPPORTED_LANGUAGES.map((l) => l.code),
-    ns: ['common', 'nav', 'errors'],
+    ns: authRoute ? ['auth'] : routeNamespaces,
+    initAsync: !authRoute,
     defaultNS: 'common',
     debug: import.meta.env.DEV,
     interpolation: { escapeValue: false },
