{
	"$schema": "https://inlang.com/schema/inlang-message-format",
	"page_title": "Leseliste",
	"intro": "Ein wenig lesen, in deiner Sprache.",
	"greeting": "Willkommen, {name}.",
	"task_count": [
		{
			"declarations": ["input count", "local countExact = count", "local countPlural = count: plural"],
			"selectors": ["countExact", "countPlural"],
			"match": {
				"countExact=0, countPlural=*": "Noch keine Bücher auf deiner Liste",
				"countExact=*, countPlural=one": "{count} Buch auf deiner Liste",
				"countExact=*, countPlural=*": "{count} Bücher auf deiner Liste"
			}
		}
	],
	"language_label": "Sprache",
	"decrease": "Eins entfernen",
	"increase": "Eins hinzufügen"
}
